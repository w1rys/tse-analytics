{
  "name": "tse-analytics",

  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },

  "remoteUser": "root",

  "containerEnv": {
    "POETRY_VIRTUALENVS_CREATE": "true",
    "POETRY_VIRTUALENVS_IN_PROJECT": "true",
    "PYTHONPATH": "/workspaces/tse-analytics",
    "PYSPARK_PYTHON": "/workspaces/tse-analytics/.venv/bin/python",
    "PYSPARK_DRIVER_PYTHON": "/workspaces/tse-analytics/.venv/bin/python"
  },

  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/workspaces/tse-analytics/.venv/bin/python",
        "python.terminal.activateEnvironment": true,
        "python.analysis.autoImportCompletions": true,
        "jupyter.notebookFileRoot": "${workspaceFolder}"
      },

      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter"
      ]
    }
  },

  "forwardPorts": [
    8888,
    4040
  ],

  "portsAttributes": {
    "8888": {
      "label": "JupyterLab",
      "onAutoForward": "notify"
    },

    "4040": {
      "label": "Spark UI",
      "onAutoForward": "notify"
    }
  },

  "postCreateCommand": "poetry install --no-interaction --no-ansi --no-root",

  "postStartCommand": "git config --global --add safe.directory ${containerWorkspaceFolder}"
}